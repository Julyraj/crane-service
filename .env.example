# Server
PORT=4100
NODE_ENV=development
DATA_DIR=./data
# Phones (10-digit, comma separated) that become admin on first login
ADMIN_PHONES=9789473129
# Extra allowed CORS origins for the mobile/desktop shells (comma separated)
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost
# Show OTP in API response (never enable in production)
DEV_OTP=true
# SMS provider for OTP in production: "console" (logs only) or "msg91"
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Business profile
BUSINESS_NAME=Sri Venkateswara Crane Service
BUSINESS_PHONE=9789473129
BUSINESS_UPI_ID=
BUSINESS_GSTIN=
BUSINESS_SAC=997313
BUSINESS_ADDRESS=Salem, Tamil Nadu
YARD_LAT=11.6643
YARD_LNG=78.1460

# UI build: absolute API origin when the UI runs outside the server (Capacitor app)
VITE_API_BASE=
