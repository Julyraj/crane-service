{
  "name": "@crane/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:express --outfile=dist/index.js",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "seed:demo": "tsx --env-file-if-exists=../.env src/seed-demo.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@crane/shared": "workspace:*",
    "express": "^5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
