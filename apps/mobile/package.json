{
  "name": "cranego-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "CraneGo Android / iOS app (Capacitor) for customers and crane operators.",
  "scripts": {
    "build:web": "cd ../.. && pnpm --filter @crane/ui build",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "npm run build:web && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/geolocation": "^7.1.0",
    "@capacitor/ios": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0"
  }
}
